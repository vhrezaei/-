convert_numeric_variables <- function(data) {

  for (j in seq_along(data)) {

    x <- data[[j]]

    if (is.character(x)) {

      suppressWarnings(
        x_num <- as.numeric(x)
      )

      valid_original <- !is.na(x)
      valid_numeric <- !is.na(x_num)

      if (sum(valid_original) > 0) {

        conversion_rate <-
          sum(valid_numeric & valid_original) /
          sum(valid_original)

        # اگر حداقل 90 درصد مقادیر قابل تبدیل باشند
        if (conversion_rate >= 0.90) {

          data[[j]] <- x_num
        }
      }
    }
  }

  return(data)
}


