# ============================================================

missing_rate <- function(x) {

  mean(is.na(x))
}


# ============================================================
# 7. حذف متغیرهای با Missing زیاد
# ============================================================

remove_unusable_variables <- function(data,
                                      threshold = 0.50) {

  miss_rate <- sapply(
    data,
    missing_rate
  )

  # حذف متغیرهایی که Missing آنها >= threshold است
  keep <- miss_rate < threshold

  data_filtered <- data[, keep, drop = FALSE]

  # حذف متغیرهای کاملاً Missing
  all_missing <- sapply(
    data_filtered,
    function(x) all(is.na(x))
  )

  data_filtered <- data_filtered[
    ,
    !all_missing,
    drop = FALSE
  ]

  # حذف متغیرهای بدون تغییر
  constant <- sapply(
    data_filtered,
    function(x) {

      x <- x[!is.na(x)]

      if (length(x) <= 1) {
        return(TRUE)
      }

      length(unique(x)) <= 1
    }
  )

  data_filtered <- data_filtered[
    ,
    !constant,
    drop = FALSE
  ]

  return(data_filtered)
}


