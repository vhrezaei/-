# ============================================================
# 10. ساخت Predictor Matrix
# ============================================================

create_predictor_matrix <- function(data,
                                    max_predictors = 5) {

  p <- ncol(data)

  predictor_matrix <- matrix(
    0,
    nrow = p,
    ncol = p
  )

  rownames(predictor_matrix) <- colnames(data)
  colnames(predictor_matrix) <- colnames(data)

  numeric_vars <- names(
    data
  )[
    sapply(
      data,
      is.numeric
    )
  ]

  for (target in numeric_vars) {

    # فقط متغیرهایی که با target هم داده مشاهده‌شده دارند
    correlations <- c()

    for (pred in numeric_vars) {

      if (pred == target) {
        next
      }

      complete_rows <- complete.cases(
        data[[target]],
        data[[pred]]
      )

      if (sum(complete_rows) < 3) {
        next
      }

      x <- data[[target]][complete_rows]
      y <- data[[pred]][complete_rows]

      if (
        sd(x) == 0 ||
        sd(y) == 0
      ) {
        next
      }

      cor_value <- suppressWarnings(
        cor(
          x,
          y,
          method = "pearson"
        )
      )

      if (!is.na(cor_value)) {

        correlations[pred] <-
          abs(cor_value)
      }
    }

    if (length(correlations) > 0) {

      selected <- names(
        sort(
          correlations,
          decreasing = TRUE
        )
      )

      selected <- head(
        selected,
        max_predictors
      )

      predictor_matrix[
        target,
        selected
      ] <- 1
    }
  }

  return(predictor_matrix)
}


