# ============================================================
# 12. حذف هم‌خطی چندمتغیره
# ============================================================

remove_singular_predictors <- function(
    data,
    predictor_matrix) {

  vars <- colnames(data)

  for (target in vars) {

    preds <- vars[
      predictor_matrix[target, ] == 1
    ]

    if (length(preds) <= 1) {
      next
    }

    preds <- preds[
      sapply(
        data[preds],
        is.numeric
      )
    ]

    if (length(preds) <= 1) {
      next
    }

    # حذف متغیرهای بدون واریانس
    valid_preds <- preds[
      sapply(
        data[preds],
        function(x) {

          x <- x[!is.na(x)]

          length(x) > 1 &&
            sd(x) > 0
        }
      )
    ]

    preds <- valid_preds

    if (length(preds) <= 1) {

      predictor_matrix[target, ] <- 0

      if (length(preds) == 1) {

        predictor_matrix[
          target,
          preds
        ] <- 1
      }

      next
    }

    temp <- data[preds]

    complete_rows <- complete.cases(
      temp
    )

    temp <- temp[
      complete_rows,
      ,
      drop = FALSE
    ]

    if (nrow(temp) < 3) {
      next
    }

    # حذف تدریجی متغیرهای هم‌خط
    repeat {

      if (ncol(temp) <= 1) {
        break
      }

      qr_result <- qr(
        as.matrix(temp)
      )

      # ماتریس full rank است
      if (
        qr_result$rank ==
        ncol(temp)
      ) {
        break
      }

      remove_index <-
        qr_result$pivot[
          qr_result$rank + 1
        ]

      remove_var <-
        colnames(temp)[
          remove_index
        ]

      cat(
        "حذف predictor هم‌خط برای",
        target,
        ":",
        remove_var,
        "\n"
      )

      predictor_matrix[
        target,
        remove_var
      ] <- 0

      temp <- temp[
        ,
        setdiff(
          colnames(temp),
          remove_var
        ),
        drop = FALSE
      ]
    }
  }

  return(predictor_matrix)
}


