# ============================================================
# 11. حذف همبستگی بسیار بالا
# ============================================================

remove_collinear_predictors <- function(
    data,
    predictor_matrix,
    threshold = 0.999) {

  vars <- colnames(data)

  for (target in vars) {

    preds <- vars[
      predictor_matrix[target, ] == 1
    ]

    if (length(preds) <= 1) {
      next
    }

    preds <- preds[
      sapply(
        data[preds],
        is.numeric
      )
    ]

    if (length(preds) <= 1) {
      next
    }

    repeat {

      if (length(preds) <= 1) {
        break
      }

      cor_matrix <- suppressWarnings(
        cor(
          data[preds],
          use = "pairwise.complete.obs"
        )
      )

      if (all(is.na(cor_matrix))) {
        break
      }

      cor_matrix[
        lower.tri(cor_matrix, diag = TRUE)
      ] <- NA

      max_cor <- max(
        abs(cor_matrix),
        na.rm = TRUE
      )

      if (
        !is.finite(max_cor) ||
        max_cor <= threshold
      ) {
        break
      }

      position <- which(
        abs(cor_matrix) == max_cor,
        arr.ind = TRUE
      )[1, ]

      var1 <- colnames(cor_matrix)[position[1]]
      var2 <- colnames(cor_matrix)[position[2]]

      # متغیری که Missing بیشتری دارد حذف می‌شود
      miss1 <- mean(
        is.na(data[[var1]])
      )

      miss2 <- mean(
        is.na(data[[var2]])
      )

      if (miss1 >= miss2) {

        remove_var <- var1

      } else {

        remove_var <- var2
      }

      cat(
        "حذف predictor با همبستگی بالا برای",
        target,
        ":",
        remove_var,
        "\n"
      )

      predictor_matrix[
        target,
        remove_var
      ] <- 0

      preds <- setdiff(
        preds,
        remove_var
      )
    }
  }

  return(predictor_matrix)
}


