# ============================================================
# 15. تابع اجرای امن MICE
# ============================================================

run_mice_safe <- function(
    data,
    method,
    predictor_matrix,
    seed = 123) {

  result_data <- data
  mice_object <- NULL

  if (
    sum(is.na(data)) == 0
  ) {

    cat(
      "هیچ Missingای وجود ندارد؛ MICE اجرا نمی‌شود.\n"
    )

    return(
      list(
        data = result_data,
        mice = NULL,
        success = TRUE
      )
    )
  }

  tryCatch({

    mice_object <- mice(
      data,
      m = 1,
      method = method,
      predictorMatrix = predictor_matrix,
      seed = seed,
      maxit = 10,
      printFlag = TRUE
    )

    result_data <-
      complete(
        mice_object,
        1
      )

    cat(
      "\nMICE با موفقیت اجرا شد.\n"
    )

    return(
      list(
        data = result_data,
        mice = mice_object,
        success = TRUE
      )
    )

  }, error = function(e) {

    cat(
      "\n⚠️ MICE با خطا مواجه شد:\n"
    )

    cat(
      conditionMessage(e),
      "\n"
    )

    cat(
      "\nادامه کار با روش‌های جایگزین...\n"
    )

    return(
      list(
        data = data,
        mice = NULL,
        success = FALSE
      )
    )
  })
}


