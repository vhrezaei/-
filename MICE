# 18. تابع Regression + Residual
# ============================================================

fallback_regression_imputation <- function(
    original_data,
    imputed_data,
    predictor_matrix) {

  log <- data.frame(
    Variable = character(),
    Method = character(),
    N_Imputed = integer(),
    stringsAsFactors = FALSE
  )

  vars <- colnames(
    original_data
  )

  for (target in vars) {

    missing_rows <- which(
      is.na(
        original_data[[target]]
      )
    )

    if (
      length(missing_rows) == 0
    ) {
      next
    }

    # فقط متغیرهای عددی
    if (
      !is.numeric(
        original_data[[target]]
      )
    ) {
      next
    }

    predictors <- vars[
      predictor_matrix[target, ] == 1
    ]

    predictors <- predictors[
      sapply(
        original_data[predictors],
        is.numeric
      )
    ]

    if (
      length(predictors) == 0
    ) {
      next
    }

    # فقط complete cases برای آموزش مدل
    train_data <- original_data[
      ,
      c(target, predictors),
      drop = FALSE
    ]

    train_data <- train_data[
      complete.cases(train_data),
      ,
      drop = FALSE
    ]

    if (
      nrow(train_data) < 10
    ) {
      next
    }

    # فرمول
    formula <- as.formula(
      paste(
        target,
        "~",
        paste(
          predictors,
          collapse = " + "
        )
      )
    )

    model <- tryCatch(

      lm(
        formula,
        data = train_data
      ),

      error = function(e)
        NULL
    )

    if (
      is.null(model)
    ) {
      next
    }

    # ردیف‌های دارای predictor برای پیش‌بینی
    new_data <- imputed_data[
      missing_rows,
      predictors,
      drop = FALSE
    ]

    valid_prediction <- complete.cases(
      new_data
    )

    if (
      !any(valid_prediction)
    ) {
      next
    }

    predicted <- tryCatch(

      predict(
        model,
        newdata = new_data[
          valid_prediction,
          ,
          drop = FALSE
        ]
      ),

      error = function(e)
        NULL
    )

    if (
      is.null(predicted)
    ) {
      next
    }

    # محاسبه residual
    residuals_model <- residuals(
      model
    )

    residual_sd <- sd(
      residuals_model,
      na.rm = TRUE
    )

    if (
      !is.finite(residual_sd)
    ) {
      residual_sd <- 0
    }

    # اضافه کردن residual تصادفی
    predicted <- predicted +
      rnorm(
        length(predicted),
        mean = 0,
        sd = residual_sd
      )

    rows_to_fill <-
      missing_rows[
        valid_prediction
      ]

    # اگر متغیر ذاتاً غیرمنفی باشد
    observed_values <-
      original_data[[target]][
        !is.na(
          original_data[[target]]
        )
      ]

    if (
      length(observed_values) > 0 &&
      all(
        observed_values >= 0
      )
    ) {

      predicted[
        predicted < 0
      ] <- 0
    }

    imputed_data[
      rows_to_fill,
      target
    ] <- predicted

    log <- rbind(
      log,
      data.frame(
        Variable = target,
        Method = "Regression + Residual",
        N_Imputed = length(
          rows_to_fill
        ),
        stringsAsFactors = FALSE
      )
    )
  }

  return(
    list(
      data = imputed_data,
      log = log
    )
  )
}


# ============================================================
# 19. تابع Random Sampling
# ============================================================

random_sampling_imputation <- function(
    original_data,
    imputed_data) {

  log <- data.frame(
    Variable = character(),
    Method = character(),
    N_Imputed = integer(),
    stringsAsFactors = FALSE
  )

  vars <- colnames(
    original_data
  )

  for (target in vars) {

    missing_rows <- which(
      is.na(
        imputed_data[[target]]
      )
    )

    if (
      length(missing_rows) == 0
    ) {
      next
    }

    observed_values <-
      original_data[[target]][
        !is.na(
          original_data[[target]]
        )
      ]

    if (
      length(observed_values) == 0
    ) {
      next
    }

    sampled_values <- sample(
      observed_values,
      size = length(missing_rows),
      replace = TRUE
    )

    imputed_data[
      missing_rows,
      target
    ] <- sampled_values

    log <- rbind(
      log,
      data.frame(
        Variable = target,
        Method = "Random Sampling",
        N_Imputed = length(
          missing_rows
        ),
        stringsAsFactors = FALSE
      )
    )
  }

  return(
    list(
      data = imputed_data,
      log = log
    )
  )
}


